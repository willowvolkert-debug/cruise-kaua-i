{
  "name": "SMS: Booking Accepted or Denied",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"booking_status\") != null) and (.trigger.data.booking_status == \"confirmed\" or .trigger.data.booking_status == \"rejected\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "RideBooking"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sms_booking_accepted_or_denied",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "smsNotifyBookingStatusChanged",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "smsNotifyBookingStatusChanged"
  }
}