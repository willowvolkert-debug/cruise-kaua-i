{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Pacific/Honolulu",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Cleanup Expired Alerts and Relief Posts",
  "description": "Daily: removes road alerts not re-confirmed in 24h and relief posts older than 1 month",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cleanup_expired_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_cleanup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "cleanupExpiredAlerts",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Remove expired items",
            "description": "Road alerts + relief posts"
          }
        }
      }
    ]
  }
}