{
  "name": "KupunaSignup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the k\u016bpuna"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number"
    }
  },
  "required": [
    "name",
    "phone_number"
  ],
  "rls": {
    "create": {
      "*": "*"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}