{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "approx_students": {
      "type": "integer"
    },
    "island": {
      "type": "string"
    },
    "password_hash": {
      "type": "string"
    },
    "password_salt": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "location"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}