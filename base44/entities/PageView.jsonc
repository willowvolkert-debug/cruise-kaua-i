{
  "name": "PageView",
  "type": "object",
  "properties": {
    "page_name": {
      "type": "string",
      "description": "Name of the page viewed"
    },
    "user_id": {
      "type": "string",
      "description": "ID of user who viewed the page (if logged in)"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    }
  },
  "required": [
    "page_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}