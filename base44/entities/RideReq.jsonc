{
  "name": "RideReq",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.name": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "*": "*"
    },
    "update": {
      "*": "*"
    },
    "delete": {
      "*": "*"
    }
  }
}