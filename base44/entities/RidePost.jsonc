{
  "name": "RidePost",
  "type": "object",
  "properties": {
    "rider_id": {
      "type": "string"
    },
    "rider_name": {
      "type": "string"
    },
    "rider_username": {
      "type": "string"
    },
    "rider_profile_picture_url": {
      "type": "string"
    },
    "rider_bio": {
      "type": "string"
    },
    "rider_age": {
      "type": "integer"
    },
    "rider_gender": {
      "type": "string"
    },
    "departure_location": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "departure_time": {
      "type": "string"
    },
    "is_flexible": {
      "type": "boolean",
      "default": false
    },
    "seats_needed": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "has_luggage": {
      "type": "boolean",
      "default": false
    },
    "island": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": [
    "rider_id",
    "rider_name",
    "departure_location",
    "destination",
    "departure_date",
    "departure_time",
    "seats_needed"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}