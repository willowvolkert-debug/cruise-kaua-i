{
  "name": "RiderRequest",
  "type": "object",
  "properties": {
    "riderName": {
      "type": "string",
      "description": "Name of the rider"
    },
    "pickupLocation": {
      "type": "string",
      "description": "Pickup location"
    },
    "dropoffLocation": {
      "type": "string",
      "description": "Drop-off location"
    },
    "status": {
      "type": "string",
      "default": "pending",
      "description": "Status of the request"
    }
  },
  "required": [
    "riderName",
    "pickupLocation",
    "dropoffLocation"
  ],
  "rls": {
    "create": {
      "*": "*"
    },
    "read": {
      "*": "*"
    },
    "update": {
      "*": "*"
    },
    "delete": {
      "*": "*"
    }
  }
}