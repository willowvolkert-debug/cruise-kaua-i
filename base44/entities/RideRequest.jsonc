{
  "name": "RideRequest",
  "type": "object",
  "properties": {
    "riderName": {
      "type": "string",
      "description": "Name of the rider making the request"
    },
    "pickupLocation": {
      "type": "string",
      "description": "Pickup location for the ride"
    },
    "dropoffLocation": {
      "type": "string",
      "description": "Drop-off location for the ride"
    },
    "status": {
      "type": "string",
      "default": "pending",
      "description": "Status of the ride request"
    }
  },
  "required": [
    "riderName",
    "pickupLocation",
    "dropoffLocation"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": "active"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}