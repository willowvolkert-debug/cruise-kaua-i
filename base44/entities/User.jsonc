{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    },
    "gender": {
      "type": "string"
    },
    "home_base": {
      "type": "string"
    },
    "profile_picture_url": {
      "type": "string"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    },
    "user_type": {
      "type": "string",
      "enum": [
        "new",
        "rider",
        "driver"
      ],
      "default": "new"
    },
    "preferred_island": {
      "type": "string"
    },
    "phone_number": {
      "type": "string",
      "description": "User's mobile phone number for SMS notifications"
    },
    "sms_notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has opted in to SMS notifications"
    },
    "drivers_license_verified": {
      "type": "boolean",
      "default": false
    },
    "drivers_license_pending_review": {
      "type": "boolean",
      "default": false
    },
    "license_rejection_reason": {
      "type": "string"
    },
    "vehicle_verified": {
      "type": "boolean",
      "default": false
    },
    "vehicle_pending_review": {
      "type": "boolean",
      "default": false
    },
    "vehicle_rejection_reason": {
      "type": "string"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false
    },
    "privacy_policy_accepted": {
      "type": "boolean",
      "default": false
    },
    "community_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "driver_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "driver_agreement_timestamp": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": false
    },
    "has_seen_welcome": {
      "type": "boolean",
      "default": false
    },
    "has_seen_tutorial": {
      "type": "boolean",
      "default": false
    },
    "has_seen_fresh_look_2025": {
      "type": "boolean",
      "default": false
    },
    "preferences_chattiness": {
      "type": "string"
    },
    "preferences_scents": {
      "type": "string"
    },
    "preferences_music": {
      "type": "string"
    },
    "bank_account_linked": {
      "type": "boolean",
      "default": false
    },
    "bank_account_holder_name": {
      "type": "string"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_account_verified": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "stripe_connect_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "total_payouts": {
      "type": "number",
      "default": 0
    },
    "unsubscribed_from_setup_reminders": {
      "type": "boolean",
      "default": false
    }
  }
}