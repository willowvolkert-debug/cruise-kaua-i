{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    },
    "gender": {
      "type": "string"
    },
    "home_base": {
      "type": "string"
    },
    "profile_picture_url": {
      "type": "string"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    },
    "user_type": {
      "type": "string",
      "enum": [
        "new",
        "rider",
        "driver"
      ],
      "default": "new"
    },
    "preferred_island": {
      "type": "string"
    },
    "is_founders_group": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user is part of the founders group for a non-Kauai island"
    },
    "phone_number": {
      "type": "string",
      "description": "User's mobile phone number for SMS notifications"
    },
    "sms_notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has opted in to SMS notifications"
    },
    "sms_notify_posted_rides": {
      "type": "boolean",
      "description": "Text me when a ride is posted. Unset = yes."
    },
    "sms_notify_ride_requests": {
      "type": "boolean",
      "description": "Text me when a ride is requested (drivers). Unset = yes."
    },
    "notify_relief": {
      "type": "boolean",
      "default": false,
      "description": "Text me about new Grey Skies relief posts"
    },
    "notify_relief_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "need",
          "resource"
        ]
      },
      "default": [],
      "description": "Which relief post kinds to be notified about"
    },
    "notify_road": {
      "type": "boolean",
      "default": false,
      "description": "Text me about new road alerts"
    },
    "notify_road_sides": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "north",
          "east",
          "south",
          "west"
        ]
      },
      "default": [],
      "description": "Sides of Kauai to get road alert texts for"
    },
    "notification_prefs_set": {
      "type": "boolean",
      "default": false
    },
    "sms_preferred_locations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Locations the user wants to receive SMS ride alerts for. Empty = all locations."
    },
    "sms_disabled_inactivity": {
      "type": "boolean",
      "default": false,
      "description": "True when SMS was turned off automatically due to 14+ days of inactivity (drives the reactivation card on the Account page)"
    },
    "last_activity_date": {
      "type": "string",
      "description": "ISO timestamp of the user's last app activity (used to determine SMS eligibility)"
    },
    "has_dismissed_phone_prompt": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has dismissed the phone number prompt"
    },
    "welcome_sms_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the one-time welcome SMS has been sent to this user"
    },
    "drivers_license_verified": {
      "type": "boolean",
      "default": false
    },
    "drivers_license_pending_review": {
      "type": "boolean",
      "default": false
    },
    "drivers_license_front_url": {
      "type": "string",
      "description": "URL to the front photo of the driver's license"
    },
    "drivers_license_back_url": {
      "type": "string",
      "description": "URL to the back photo of the driver's license"
    },
    "license_rejection_reason": {
      "type": "string"
    },
    "license_submitted_date": {
      "type": "string"
    },
    "license_expiry_date": {
      "type": "string",
      "description": "Driver's license expiry date (free-text from admin review, e.g. MM/YYYY or MM/DD/YYYY)"
    },
    "vehicle_verified": {
      "type": "boolean",
      "default": false
    },
    "vehicle_pending_review": {
      "type": "boolean",
      "default": false
    },
    "vehicle_rejection_reason": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string",
      "description": "Vehicle manufacturer"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Vehicle model"
    },
    "vehicle_year": {
      "type": "string",
      "description": "Vehicle year"
    },
    "vehicle_color": {
      "type": "string",
      "description": "Vehicle color"
    },
    "license_plate": {
      "type": "string",
      "description": "Vehicle license plate"
    },
    "seats_available": {
      "type": "integer",
      "description": "Number of seats available for riders"
    },
    "bags_allowed": {
      "type": "boolean",
      "default": true,
      "description": "Whether the driver allows bags in the vehicle"
    },
    "vehicle_exterior_photo_url": {
      "type": "string",
      "description": "URL to the exterior photo of the vehicle"
    },
    "vehicle_interior_photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "URLs to interior photos of the vehicle"
    },
    "auto_policy_photo_url": {
      "type": "string",
      "description": "URL to the auto insurance policy card photo"
    },
    "insurance_submitted_date": {
      "type": "string",
      "description": "ISO timestamp of when insurance was submitted"
    },
    "insurance_expiry_date": {
      "type": "string",
      "description": "Insurance policy expiry date (free-text from admin review, e.g. MM/YYYY or MM/DD/YYYY)"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false
    },
    "privacy_policy_accepted": {
      "type": "boolean",
      "default": false
    },
    "community_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "driver_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "driver_agreement_timestamp": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": false
    },
    "has_seen_welcome": {
      "type": "boolean",
      "default": false
    },
    "has_seen_tutorial": {
      "type": "boolean",
      "default": false
    },
    "has_seen_fresh_look_2025": {
      "type": "boolean",
      "default": false
    },
    "has_completed_profile_quiz": {
      "type": "boolean",
      "default": false
    },
    "profile_quiz_saved_step": {
      "type": "integer",
      "description": "Last completed step in the profile setup quiz, for resume-later"
    },
    "preferences_chattiness": {
      "type": "string"
    },
    "preferences_scents": {
      "type": "string"
    },
    "preferences_music": {
      "type": "string"
    },
    "bank_account_linked": {
      "type": "boolean",
      "default": false
    },
    "bank_account_holder_name": {
      "type": "string"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_account_verified": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "stripe_connect_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "total_payouts": {
      "type": "number",
      "default": 0
    },
    "unsubscribed_from_setup_reminders": {
      "type": "boolean",
      "default": false
    },
    "onboarding_email_sent": {
      "type": "boolean",
      "default": false
    },
    "email_update_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "every_3_days",
        "weekly",
        "monthly",
        "never"
      ],
      "default": "daily"
    },
    "last_setup_reminder_sent": {
      "type": "string"
    },
    "car_model": {
      "type": "string"
    },
    "driver_license_state": {
      "type": "string"
    },
    "has_posted_rides": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "username",
    "bio",
    "age",
    "gender",
    "home_base",
    "profile_picture_url",
    "preferred_island",
    "phone_number",
    "license_rejection_reason",
    "license_submitted_date",
    "vehicle_rejection_reason",
    "driver_agreement_timestamp",
    "preferences_chattiness",
    "preferences_scents",
    "preferences_music",
    "bank_account_holder_name",
    "bank_routing_number",
    "bank_account_number",
    "stripe_connect_account_id"
  ]
}