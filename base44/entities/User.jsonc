{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    },
    "gender": {
      "type": "string"
    },
    "home_base": {
      "type": "string"
    },
    "profile_picture_url": {
      "type": "string"
    },
    "profile_complete": {
      "type": "boolean",
      "default": false
    },
    "user_type": {
      "type": "string",
      "enum": [
        "new",
        "rider",
        "driver"
      ],
      "default": "new"
    },
    "preferred_island": {
      "type": "string"
    },
    "phone_number": {
      "type": "string",
      "description": "User's mobile phone number for SMS notifications"
    },
    "sms_notifications_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has opted in to SMS notifications"
    },
    "sms_disabled_inactivity": {
      "type": "boolean",
      "default": false,
      "description": "True when SMS was turned off automatically due to 14+ days of inactivity (drives the reactivation card on the Account page)"
    },
    "last_activity_date": {
      "type": "string",
      "description": "ISO timestamp of the user's last app activity (used to determine SMS eligibility)"
    },
    "has_dismissed_phone_prompt": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has dismissed the phone number prompt"
    },
    "welcome_sms_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the one-time welcome SMS has been sent to this user"
    },
    "drivers_license_verified": {
      "type": "boolean",
      "default": false
    },
    "drivers_license_pending_review": {
      "type": "boolean",
      "default": false
    },
    "license_rejection_reason": {
      "type": "string"
    },
    "license_submitted_date": {
      "type": "string"
    },
    "vehicle_verified": {
      "type": "boolean",
      "default": false
    },
    "vehicle_pending_review": {
      "type": "boolean",
      "default": false
    },
    "vehicle_rejection_reason": {
      "type": "string"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false
    },
    "privacy_policy_accepted": {
      "type": "boolean",
      "default": false
    },
    "community_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "driver_agreement_accepted": {
      "type": "boolean",
      "default": false
    },
    "driver_agreement_timestamp": {
      "type": "string"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": false
    },
    "has_seen_welcome": {
      "type": "boolean",
      "default": false
    },
    "has_seen_tutorial": {
      "type": "boolean",
      "default": false
    },
    "has_seen_fresh_look_2025": {
      "type": "boolean",
      "default": false
    },
    "has_completed_profile_quiz": {
      "type": "boolean",
      "default": false
    },
    "preferences_chattiness": {
      "type": "string"
    },
    "preferences_scents": {
      "type": "string"
    },
    "preferences_music": {
      "type": "string"
    },
    "bank_account_linked": {
      "type": "boolean",
      "default": false
    },
    "bank_account_holder_name": {
      "type": "string"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "bank_account_number": {
      "type": "string"
    },
    "bank_account_verified": {
      "type": "boolean",
      "default": false
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "stripe_connect_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "total_payouts": {
      "type": "number",
      "default": 0
    },
    "unsubscribed_from_setup_reminders": {
      "type": "boolean",
      "default": false
    },
    "onboarding_email_sent": {
      "type": "boolean",
      "default": false
    },
    "email_update_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "every_3_days",
        "weekly",
        "monthly",
        "never"
      ],
      "default": "daily"
    },
    "last_setup_reminder_sent": {
      "type": "string"
    },
    "car_model": {
      "type": "string"
    },
    "driver_license_state": {
      "type": "string"
    },
    "has_posted_rides": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "username",
    "bio",
    "age",
    "gender",
    "home_base",
    "profile_picture_url",
    "preferred_island",
    "phone_number",
    "license_rejection_reason",
    "license_submitted_date",
    "vehicle_rejection_reason",
    "driver_agreement_timestamp",
    "preferences_chattiness",
    "preferences_scents",
    "preferences_music",
    "bank_account_holder_name",
    "bank_routing_number",
    "bank_account_number",
    "stripe_connect_account_id"
  ]
}