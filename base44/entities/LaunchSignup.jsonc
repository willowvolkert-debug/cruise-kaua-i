{
  "name": "LaunchSignup",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address to receive launch updates"
    },
    "name": {
      "type": "string",
      "description": "Optional name"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}